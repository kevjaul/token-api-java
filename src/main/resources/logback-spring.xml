<springProfile name="dev,prod">
    <configuration>

        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
    [%d{yyyy-MM-dd HH:mm:ss}]%X{method:-}%X{path:-}%X{apiKey:-}%X{appId:-} -> %msg%n
                </pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

    </configuration>
</springProfile>