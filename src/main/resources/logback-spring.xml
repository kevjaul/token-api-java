<configuration>
    <springProperty name="LOG_PATH" source="logging.file.path" defaultValue="logser"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
[%d{yyyy-MM-dd HH:mm:ss}]%X{method:-}%X{path:-}%X{apiKey:-}%X{appId:-} -> %msg%n
            </pattern>
        </encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/token-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/token-app-%d{dd-MM-yyyy}.log/</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
            <maxFileSize>10MB</maxFileSize>
        </timeBasedFileNamingAndTriggeringPolicy>
        <encoder>
            <pattern>
[%d{yyyy-MM-dd HH:mm:ss}]%X{method:-}%X{path:-}%X{apiKey:-}%X{appId:-} -> %msg%n
            </pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <springProfile name="dev,prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>
    <springProfile name="test">
        <root level="ERROR"/>
    </springProfile>
</configuration>